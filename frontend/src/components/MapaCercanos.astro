---
interface Props {
  mostrar: "solicitudes" | "ofertas";
  titulo: string;
}

const { mostrar, titulo } = Astro.props;
---

<section class="mapa-seccion" data-mostrar={mostrar}>
  <button type="button" id="boton-cargar-mapa" class="boton-mapa" data-texto-original={titulo}>
    🗺️ {titulo}
  </button>
  <div id="contenedor-mapa" class="contenedor-mapa" hidden>
    <p id="mapa-estado" class="mapa-estado" role="status"></p>
    <div id="mapa" class="mapa"></div>
  </div>
</section>

<style>
  .mapa-seccion {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .boton-mapa {
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    padding: var(--space-4) var(--space-4);
    min-height: 48px;
    border-radius: var(--radius-md);
    border: 1px dashed var(--co-azul);
    background: var(--action-bg);
    color: var(--co-azul);
    cursor: pointer;
    width: 100%;
    transition: background-color 0.15s ease;
  }

  .boton-mapa:hover {
    background: rgba(31, 61, 92, 0.14);
  }

  .boton-mapa:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  .contenedor-mapa {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mapa-estado {
    margin: 0;
    font-size: 13px;
    color: var(--text-secondary);
  }

  .mapa {
    width: 100%;
    height: 320px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  /* Chrome del popup de Leaflet: se redefine para que se sienta parte del
     mismo sistema (radios, sombra y tipografía), no un widget aparte. */
  :global(.leaflet-popup-content-wrapper) {
    border-radius: var(--radius-md);
    box-shadow: var(--shadow);
  }

  :global(.leaflet-popup-content) {
    margin: var(--space-3) var(--space-4);
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.5;
    color: var(--text);
    min-width: 200px;
  }

  :global(.leaflet-popup-tip) {
    box-shadow: var(--shadow);
  }

  /* Toda la info de un pin (tipo, urgencia, distancia) agrupada en una
     sola cabecera — Ley de proximidad aplicada dentro del propio popup. */
  :global(.popup-cabecera) {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  /* Misma forma de badge para tipo y para urgencia (Similitud): solo cambia
     el color, nunca la forma — así "urgente" se reconoce sin tener que leer. */
  :global(.badge) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.01em;
    padding: 3px 10px;
    border-radius: 999px;
    line-height: 1.6;
  }

  :global(.badge-tipo) {
    background: var(--surface-sunken);
    color: var(--text);
  }

  :global(.badge-urgente) {
    background: var(--urgent-bg);
    color: var(--co-rojo);
  }

  :global(.popup-distancia) {
    margin-left: auto;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-secondary);
  }

  :global(.popup-agrupadas) {
    margin: 0 0 var(--space-2);
    font-size: 12px;
    font-weight: 600;
    color: var(--co-rojo);
  }

  :global(.popup-descripcion) {
    margin: 0 0 var(--space-3);
    color: var(--text);
  }

  :global(.popup-acciones) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  :global(.popup-accion) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    font-weight: 600;
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    background: var(--action-bg);
    color: var(--co-azul);
    text-decoration: none;
  }

  :global(.popup-reportar) {
    display: inline-block;
    font: inherit;
    font-size: 12px;
    color: var(--text-secondary);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
  }

  :global(.popup-reportar:disabled) {
    cursor: default;
    text-decoration: none;
    opacity: 0.8;
  }
</style>

<script>
  import { cargarLeaflet } from "../lib/leaflet-loader";
  import {
    buscarSolicitudes,
    buscarOfertas,
    crearReporte,
    ApiError,
    type SolicitudPublica,
    type OfertaPublica,
  } from "../lib/api";
  import { obtenerUbicacionActual, type Coordenadas } from "../lib/geolocalizacion";
  import { etiquetaTipoAyuda } from "../lib/tipos-ayuda";
  import { enlaceWhatsapp } from "../lib/whatsapp";

  const RADIO_METROS = 5000;

  // Paleta del sistema de diseño (no se puede leer var() de CSS desde opciones de Leaflet).
  const COLOR_URGENTE = "#a13327";
  const COLOR_ACCION = "#1f3d5c";
  const COLOR_NEUTRO = "#66635d";
  const COLOR_BLANCO = "#ffffff";

  interface LeafletModulo {
    map: (el: HTMLElement) => LeafletMapa;
    tileLayer: (url: string, opts: Record<string, unknown>) => { addTo: (mapa: LeafletMapa) => void };
    circleMarker: (
      coords: [number, number],
      opts: Record<string, unknown>,
    ) => { addTo: (mapa: LeafletMapa) => LeafletMarcador };
  }
  interface LeafletMapa {
    setView: (coords: [number, number], zoom: number) => LeafletMapa;
  }
  interface LeafletMarcador {
    bindPopup: (html: string) => LeafletMarcador;
  }

  function escaparHtml(texto: string): string {
    const div = document.createElement("div");
    div.textContent = texto;
    return div.innerHTML;
  }

  // Redondeada a propósito: la ubicación que devuelve la API ya viene aproximada
  // (~110 m), mostrar metros exactos daría una falsa sensación de precisión.
  function calcularDistancia(origen: Coordenadas, lat: number, lng: number): string {
    const R = 6371000;
    const rad = Math.PI / 180;
    const dLat = (lat - origen.lat) * rad;
    const dLng = (lng - origen.lng) * rad;
    const a =
      Math.sin(dLat / 2) ** 2 +
      Math.cos(origen.lat * rad) * Math.cos(lat * rad) * Math.sin(dLng / 2) ** 2;
    const metros = R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    const redondeado = Math.round(metros / 100) * 100;
    return redondeado < 1000 ? `~${redondeado} m` : `~${(redondeado / 1000).toFixed(1)} km`;
  }

  function construirPopup(
    item: SolicitudPublica | OfertaPublica,
    tipoEntidad: "SOLICITUD" | "OFERTA",
    distancia: string,
  ): string {
    const urgente = "urgente" in item && item.urgente;

    const partes: string[] = ['<div class="popup-cabecera">'];
    partes.push(`<span class="badge badge-tipo">${escaparHtml(etiquetaTipoAyuda(item.tipoAyuda))}</span>`);
    if (urgente) {
      partes.push('<span class="badge badge-urgente">🔴 Urgente</span>');
    }
    partes.push(`<span class="popup-distancia">${distancia}</span>`);
    partes.push("</div>");

    if (urgente && "solicitudesAgrupadas" in item) {
      partes.push(`<p class="popup-agrupadas">${item.solicitudesAgrupadas} solicitudes similares en la zona</p>`);
    }

    partes.push(`<p class="popup-descripcion">${escaparHtml(item.descripcion)}</p>`);

    const acciones: string[] = [];
    if (item.contactoWhatsapp) {
      acciones.push(
        `<a class="popup-accion" href="${enlaceWhatsapp(item.contactoWhatsapp)}" target="_blank" rel="noopener">📱 WhatsApp</a>`,
      );
    }
    if (item.contactoEmail) {
      acciones.push(`<a class="popup-accion" href="mailto:${item.contactoEmail}">✉️ Correo</a>`);
    }
    if (acciones.length > 0) {
      partes.push(`<div class="popup-acciones">${acciones.join("")}</div>`);
    }

    partes.push(
      `<button type="button" class="popup-reportar" data-reportar-id="${item.id}" data-reportar-tipo="${tipoEntidad}">🚩 Reportar</button>`,
    );

    return partes.join("");
  }

  const seccion = document.querySelector<HTMLElement>(".mapa-seccion");
  const boton = document.getElementById("boton-cargar-mapa") as HTMLButtonElement | null;
  const contenedor = document.getElementById("contenedor-mapa");
  const estado = document.getElementById("mapa-estado");
  const mapaDiv = document.getElementById("mapa");

  if (seccion && boton && contenedor && estado && mapaDiv) {
    const mostrar = seccion.dataset.mostrar === "ofertas" ? "ofertas" : "solicitudes";

    // Delegado en el contenedor del mapa: los popups de Leaflet se insertan en el DOM recien
    // cuando se abren, así que un listener directo sobre cada botón no serviría.
    mapaDiv.addEventListener("click", async (evento) => {
      const boton_reportar = (evento.target as HTMLElement).closest<HTMLButtonElement>("[data-reportar-id]");
      if (!boton_reportar) return;

      const motivo = window.prompt("¿Por qué quieres reportar esta publicación?");
      if (!motivo || !motivo.trim()) return;

      const entidadId = boton_reportar.dataset.reportarId as string;
      const tipoEntidad = boton_reportar.dataset.reportarTipo === "OFERTA" ? "OFERTA" : "SOLICITUD";

      boton_reportar.disabled = true;
      boton_reportar.textContent = "Enviando...";
      try {
        await crearReporte({ entidadId, tipoEntidad, motivo: motivo.trim() });
        boton_reportar.textContent = "✅ Reportado, gracias";
      } catch {
        boton_reportar.textContent = "No se pudo reportar. Intenta de nuevo.";
        boton_reportar.disabled = false;
      }
    });

    boton.addEventListener("click", async () => {
      boton.disabled = true;
      boton.textContent = "Cargando mapa...";
      contenedor.hidden = false;

      try {
        estado.textContent = "Obteniendo tu ubicación...";
        const ubicacion = await obtenerUbicacionActual();

        estado.textContent = "Cargando mapa...";
        const L = (await cargarLeaflet()) as LeafletModulo;

        const mapa = L.map(mapaDiv).setView([ubicacion.lat, ubicacion.lng], 13);
        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
          attribution: "&copy; colaboradores de OpenStreetMap",
          maxZoom: 19,
        }).addTo(mapa);

        L.circleMarker([ubicacion.lat, ubicacion.lng], {
          radius: 7,
          color: COLOR_BLANCO,
          weight: 2,
          fillColor: COLOR_ACCION,
          fillOpacity: 1,
        })
          .addTo(mapa)
          .bindPopup("Tu ubicación aproximada");

        estado.textContent = "Buscando publicaciones cercanas...";
        const resultados =
          mostrar === "ofertas"
            ? await buscarOfertas({ lat: ubicacion.lat, lng: ubicacion.lng, radio: RADIO_METROS })
            : await buscarSolicitudes({ lat: ubicacion.lat, lng: ubicacion.lng, radio: RADIO_METROS });

        estado.textContent =
          resultados.length === 0
            ? "No hay publicaciones cercanas todavía en un radio de 5 km."
            : `${resultados.length} publicación(es) encontradas en un radio de 5 km.`;

        const tipoEntidad = mostrar === "ofertas" ? "OFERTA" : "SOLICITUD";

        resultados.forEach((item: SolicitudPublica | OfertaPublica) => {
          const urgente = "urgente" in item && item.urgente;
          // Blanco en el trazo (no en el relleno): asi el pin se recorta del fondo
          // del mapa sin importar si cae sobre un area verde, cafe o gris del tile.
          const colorRelleno = urgente ? COLOR_URGENTE : mostrar === "ofertas" ? COLOR_ACCION : COLOR_NEUTRO;

          const marcador = L.circleMarker([item.lat, item.lng], {
            radius: urgente ? 12 : 8,
            color: COLOR_BLANCO,
            weight: urgente ? 3 : 2,
            fillColor: colorRelleno,
            fillOpacity: 0.95,
          }).addTo(mapa);

          const distancia = calcularDistancia(ubicacion, item.lat, item.lng);
          marcador.bindPopup(construirPopup(item, tipoEntidad, distancia));
        });

        boton.remove();
      } catch (error) {
        boton.disabled = false;
        boton.textContent = `🗺️ ${boton.dataset.textoOriginal ?? "Ver mapa"}`;
        const mensaje = error instanceof ApiError || error instanceof Error ? error.message : "No se pudo cargar el mapa.";
        estado.textContent = mensaje;
      }
    });
  }
</script>
