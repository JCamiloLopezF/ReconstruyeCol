---
import Layout from "../layouts/Layout.astro";
import FormularioPublicacion from "../components/FormularioPublicacion.astro";
import MapaCercanos from "../components/MapaCercanos.astro";
---

<Layout title="Necesito ayuda — ReconstruyeCol">
  <main>
    <a class="back" href="/">← Volver</a>
    <header class="encabezado">
      <span class="icon" aria-hidden="true">🆘</span>
      <h1>Necesito ayuda</h1>
      <p>
        Publica qué necesitas (agua, alimentos, refugio, transporte u otro) para que
        alguien cerca pueda contactarte directamente.
      </p>
    </header>

    <FormularioPublicacion tipo="solicitud" />

    <MapaCercanos mostrar="ofertas" titulo="Ver quién ofrece ayuda cerca de ti" />
  </main>
</Layout>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-5) var(--space-5) var(--space-7);
    max-width: 520px;
    margin: 0 auto;
  }

  .back {
    align-self: flex-start;
    font-size: 15px;
    font-weight: 500;
    color: var(--co-azul);
    text-decoration: none;
  }

  .encabezado {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
  }

  .icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    background: var(--urgent-bg);
    font-size: 28px;
    margin-bottom: var(--space-1);
  }

  h1 {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .encabezado p {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-secondary);
    max-width: 42ch;
  }
</style>
