---
import Layout from "../../layouts/Layout.astro";
import { TIPOS_ORGANIZACION } from "../../lib/tipos-organizacion";
---

<Layout title="Registro de organización — ReconstruyeCol">
  <main>
    <a class="back" href="/quiero-ayudar">← Volver</a>
    <header class="encabezado">
      <span class="icon" aria-hidden="true">🏢</span>
      <h1>Registro de organización o centro de acopio</h1>
      <p>
        Autoregistra tu ONG, fundación o centro de acopio para aparecer como punto de
        contacto. No hay verificación automática: nuestro equipo puede marcarla como
        "verificada" más adelante.
      </p>
    </header>

    <form id="formulario-organizacion" class="formulario" novalidate>
      <div class="campo">
        <label for="campo-nombre">Nombre de la organización</label>
        <input id="campo-nombre" name="nombre" type="text" required maxlength="255" />
      </div>

      <div class="campo">
        <label for="campo-tipo">Tipo</label>
        <select id="campo-tipo" name="tipo" required>
          <option value="" selected disabled>Selecciona una opción</option>
          {TIPOS_ORGANIZACION.map((t) => <option value={t.value}>{t.label}</option>)}
        </select>
      </div>

      <div class="campo">
        <span class="campo-label" id="etiqueta-ubicacion">Ubicación</span>
        <button type="button" id="boton-ubicacion" class="boton-secundario" aria-describedby="estado-ubicacion">
          📍 Usar mi ubicación actual
        </button>
        <p id="estado-ubicacion" class="estado-ubicacion" role="status">
          Necesitamos la ubicación para que puedan encontrarlos en el mapa.
        </p>
      </div>

      <div class="campo">
        <label for="campo-contacto">Contacto (WhatsApp o correo)</label>
        <input id="campo-contacto" name="contacto" type="text" required maxlength="255"
          placeholder="Ej: 3001234567 o contacto@ong.org" />
      </div>

      <div class="campo campo-checkbox">
        <input id="campo-consentimiento" name="consentimiento" type="checkbox" required />
        <label for="campo-consentimiento">
          Autorizo el tratamiento de estos datos para mostrar públicamente esta organización
          como punto de contacto. <a href="/aviso-privacidad">Ver aviso de privacidad</a>.
        </label>
      </div>

      <p id="mensaje-error" class="mensaje-error" role="alert" hidden></p>

      <button type="submit" id="boton-enviar" class="boton-primario">Registrar organización</button>
    </form>

    <div id="pantalla-exito" class="pantalla-exito" hidden>
      <span class="exito-icono" aria-hidden="true">✅</span>
      <h2>¡Organización registrada!</h2>
      <p>Ya aparece en la plataforma como punto de contacto.</p>
      <a href="/" class="boton-texto">Volver al inicio</a>
    </div>
  </main>
</Layout>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 24px 20px 48px;
    max-width: 520px;
    margin: 0 auto;
  }

  .back {
    align-self: flex-start;
    font-size: 15px;
    font-weight: 500;
    color: var(--co-azul);
    text-decoration: none;
  }

  .encabezado {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
  }

  .icon {
    font-size: 36px;
  }

  h1 {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .encabezado p {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 44ch;
  }

  .formulario {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  label,
  .campo-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
  }

  input[type="text"],
  select {
    font: inherit;
    font-size: 16px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    min-height: 44px;
  }

  .boton-secundario {
    align-self: flex-start;
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    padding: 12px 16px;
    min-height: 44px;
    border-radius: var(--radius-md);
    border: 1px solid var(--co-azul);
    background: var(--surface);
    color: var(--co-azul);
    cursor: pointer;
  }

  .boton-secundario:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .estado-ubicacion {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
    color: var(--text-secondary);
  }

  .campo-checkbox {
    flex-direction: row;
    align-items: flex-start;
    gap: 10px;
  }

  .campo-checkbox input {
    margin-top: 3px;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .campo-checkbox label {
    font-size: 13px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .campo-checkbox a {
    color: var(--co-azul);
    font-weight: 600;
  }

  .mensaje-error {
    margin: 0;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: rgba(206, 17, 38, 0.08);
    border: 1px solid rgba(206, 17, 38, 0.3);
    color: var(--co-rojo);
    font-size: 14px;
  }

  .boton-primario {
    font: inherit;
    font-size: 16px;
    font-weight: 700;
    padding: 14px 20px;
    min-height: 48px;
    border-radius: var(--radius-md);
    border: none;
    background: var(--co-rojo);
    color: #fff;
    cursor: pointer;
  }

  .boton-primario:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .pantalla-exito {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    padding: 24px 4px;
  }

  .exito-icono {
    font-size: 40px;
  }

  .pantalla-exito h2 {
    margin: 0;
    font-size: 22px;
    color: var(--text);
  }

  .pantalla-exito p {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 40ch;
  }

  .boton-texto {
    font-size: 14px;
    font-weight: 600;
    color: var(--co-azul);
    text-decoration: none;
    margin-top: 4px;
  }
</style>

<script>
  import { registrarOrganizacion, ApiError } from "../../lib/api";
  import { obtenerUbicacionActual, type Coordenadas } from "../../lib/geolocalizacion";
  import type { TipoOrganizacion } from "../../lib/tipos-organizacion";

  const formulario = document.getElementById("formulario-organizacion") as HTMLFormElement | null;
  const botonUbicacion = document.getElementById("boton-ubicacion") as HTMLButtonElement | null;
  const estadoUbicacion = document.getElementById("estado-ubicacion");
  const mensajeError = document.getElementById("mensaje-error");
  const botonEnviar = document.getElementById("boton-enviar") as HTMLButtonElement | null;
  const pantallaExito = document.getElementById("pantalla-exito");

  let ubicacion: Coordenadas | null = null;

  function mostrarError(texto: string): void {
    if (!mensajeError) return;
    mensajeError.textContent = texto;
    mensajeError.hidden = false;
  }

  function ocultarError(): void {
    if (!mensajeError) return;
    mensajeError.hidden = true;
    mensajeError.textContent = "";
  }

  if (formulario && botonUbicacion && estadoUbicacion && mensajeError && botonEnviar && pantallaExito) {
    botonUbicacion.addEventListener("click", async () => {
      botonUbicacion.disabled = true;
      estadoUbicacion.textContent = "Obteniendo la ubicación...";
      try {
        ubicacion = await obtenerUbicacionActual();
        estadoUbicacion.textContent = "✅ Ubicación obtenida. Ya puedes enviar el formulario.";
      } catch (error) {
        estadoUbicacion.textContent =
          error instanceof Error ? error.message : "No se pudo obtener la ubicación.";
      } finally {
        botonUbicacion.disabled = false;
      }
    });

    formulario.addEventListener("submit", async (evento) => {
      evento.preventDefault();
      ocultarError();

      const datos = new FormData(formulario);
      const nombre = String(datos.get("nombre") || "").trim();
      const tipo = String(datos.get("tipo") || "") as TipoOrganizacion | "";
      const contacto = String(datos.get("contacto") || "").trim();
      const consentimiento = datos.get("consentimiento") === "on";

      if (!nombre) {
        mostrarError("Escribe el nombre de la organización.");
        return;
      }
      if (!tipo) {
        mostrarError("Selecciona un tipo de organización.");
        return;
      }
      if (!ubicacion) {
        mostrarError("Usa el botón de ubicación antes de enviar.");
        return;
      }
      if (!contacto) {
        mostrarError("Escribe un WhatsApp o correo de contacto.");
        return;
      }
      if (!consentimiento) {
        mostrarError("Debes aceptar el aviso de privacidad para continuar.");
        return;
      }

      botonEnviar.disabled = true;
      botonEnviar.textContent = "Enviando...";

      try {
        await registrarOrganizacion({
          nombre,
          tipo,
          lat: ubicacion.lat,
          lng: ubicacion.lng,
          contacto,
        });

        formulario.hidden = true;
        pantallaExito.hidden = false;
      } catch (error) {
        const mensaje = error instanceof ApiError ? error.message : "No se pudo completar el registro. Intenta de nuevo.";
        mostrarError(mensaje);
        botonEnviar.disabled = false;
        botonEnviar.textContent = "Registrar organización";
      }
    });
  }
</script>
