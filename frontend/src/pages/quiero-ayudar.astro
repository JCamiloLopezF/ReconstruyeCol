---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Quiero ayudar — ReconstruyeCol">
  <main>
    <a class="back" href="/">← Volver</a>
    <span class="icon" aria-hidden="true">🤝</span>
    <h1>Quiero ayudar</h1>
    <p>
      Aquí vas a poder publicar qué puedes ofrecer (donaciones, transporte,
      maquinaria o conocimiento) para que alguien cerca pueda encontrarte.
      Esta parte del sitio está en construcción.
    </p>
  </main>
</Layout>

<style>
  main {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 12px;
    padding: 32px 20px;
    max-width: 480px;
    margin: 0 auto;
  }

  .back {
    align-self: flex-start;
    font-size: 15px;
    font-weight: 500;
    color: var(--co-azul);
    text-decoration: none;
    margin-bottom: 12px;
  }

  .icon {
    font-size: 40px;
  }

  h1 {
    margin: 0;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  p {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-secondary);
  }
</style>
