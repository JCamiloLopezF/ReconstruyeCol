---
import Layout from "../layouts/Layout.astro";
import FormularioPublicacion from "../components/FormularioPublicacion.astro";
import MapaCercanos from "../components/MapaCercanos.astro";
---

<Layout title="Quiero ayudar — ReconstruyeCol">
  <main>
    <a class="back" href="/">← Volver</a>
    <header class="encabezado">
      <span class="icon" aria-hidden="true">🤝</span>
      <h1>Quiero ayudar</h1>
      <p>
        Publica qué puedes ofrecer (donaciones, transporte, maquinaria o conocimiento)
        para que alguien cerca pueda encontrarte.
      </p>
    </header>

    <FormularioPublicacion tipo="oferta" />

    <p class="enlace-ingeniero">
      ¿Eres ingeniero o ingeniera estructural?
      <a href="/ingenieros/registro">Regístrate para ofrecer asesoría verificada</a>.
    </p>

    <p class="enlace-ingeniero">
      ¿Representas una ONG o un centro de acopio?
      <a href="/organizaciones/registro">Regístrala aquí</a>.
    </p>

    <MapaCercanos mostrar="solicitudes" titulo="Ver qué se necesita cerca de ti" />
  </main>
</Layout>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 24px 20px 48px;
    max-width: 520px;
    margin: 0 auto;
  }

  .back {
    align-self: flex-start;
    font-size: 15px;
    font-weight: 500;
    color: var(--co-azul);
    text-decoration: none;
  }

  .encabezado {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
  }

  .icon {
    font-size: 36px;
  }

  h1 {
    margin: 0;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .encabezado p {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 42ch;
  }

  .enlace-ingeniero {
    text-align: center;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: -8px 0 0;
  }

  .enlace-ingeniero a {
    color: var(--co-azul);
    font-weight: 600;
    text-decoration: none;
  }
</style>
