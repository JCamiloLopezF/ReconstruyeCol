---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Mi cuenta — ReconstruyeCol">
  <main>
    <header class="encabezado">
      <span class="icon" aria-hidden="true">🏗️</span>
      <h1>Mi cuenta de ingeniero</h1>
    </header>

    <p id="estado-badge" class="estado-badge" role="status"></p>

    <p id="mensaje-pendiente" class="mensaje-info" hidden>
      Tu cuenta todavía está en revisión. Puedes publicar una oferta de asesoría estructural,
      pero va a mostrarse etiquetada como "pendiente de verificación" hasta que un administrador
      apruebe tu soporte.
    </p>

    <a href="/quiero-ayudar" class="boton-secundario">Publicar una oferta</a>
    <button type="button" id="boton-salir" class="boton-texto">Cerrar sesión</button>
  </main>
</Layout>

<style>
  main {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    padding: 24px 20px 48px;
    max-width: 420px;
    margin: 0 auto;
  }

  .encabezado {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .icon {
    font-size: 36px;
  }

  h1 {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .estado-badge {
    margin: 0;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
  }

  .mensaje-info {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 42ch;
  }

  .boton-secundario {
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    padding: 12px 20px;
    min-height: 44px;
    border-radius: var(--radius-md);
    border: 1px solid var(--co-azul);
    background: var(--surface);
    color: var(--co-azul);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }

  .boton-texto {
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    color: var(--co-rojo);
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: underline;
  }
</style>

<script>
  import { obtenerSesion, cerrarSesion, etiquetaEstadoVerificacion } from "../../lib/auth";

  const sesion = obtenerSesion();
  if (!sesion || sesion.rol !== "INGENIERO") {
    window.location.href = sesion?.rol === "ADMIN" ? "/admin" : "/ingenieros/login";
  } else {
    const badge = document.getElementById("estado-badge");
    const mensajePendiente = document.getElementById("mensaje-pendiente");
    if (badge && sesion.estadoVerificacion) {
      badge.textContent = etiquetaEstadoVerificacion(sesion.estadoVerificacion);
    }
    if (mensajePendiente && sesion.estadoVerificacion === "PENDIENTE") {
      mensajePendiente.hidden = false;
    }
  }

  const botonSalir = document.getElementById("boton-salir");
  botonSalir?.addEventListener("click", () => {
    cerrarSesion();
    window.location.href = "/";
  });
</script>
